theorem expression_identity (p z pad : ℝ) (hcap : 1-(z-p)≠0) :
    n0 p z pad=(-(headCleared (StaticLow.lam:ℝ) (StaticLow.slack:ℝ) p z (cubicControlDeficit (Certificates.LineControl.slope (StaticLow.lam:ℝ) (StaticLow.slack:ℝ)) (Certificates.LineControl.alpha (StaticLow.lam:ℝ) (StaticLow.slack:ℝ)) (Certificates.LineControl.crossing (StaticLow.lam:ℝ) (StaticLow.slack:ℝ)) z)))*d0 p z pad := by
  norm_num [IntermediateSelectedExpressions.deficitCoefficient,IntermediateSelectedExpressions.core,
    IntermediateSelectedExpressions.capCore,IntermediateSelectedExpressions.headCore,
    IntermediateSelectedExpressions.headCleared,IntermediateSelectedExpressions.capCleared,
    IntermediateSelectedExpressions.highCore,IntermediateSelectedExpressions.base,
    IntermediateSelectedExpressions.splitLinear,IntermediateSelectedExpressions.kink,
    IntermediateTailExpressions.headLinear,IntermediateTailExpressions.massFactor,
    IntermediateTailExpressions.etaNumerator,IntermediateTailExpressions.massPrimitive,
    IntermediateTailExpressions.complementUpper,IntermediateTailExpressions.weight,
    IntermediateTailExpressions.headScore,cubicControlDeficit,
    Certificates.LineControl.slope,Certificates.LineControl.alpha,Certificates.LineControl.crossing,
    SmallMassExpressions.initial,SmallMassExpressions.slope,headInitial,headSlope,
    Variational.capDeficit,Variational.cap,Variational.capScore,Variational.quadratic,SmallMassExpressions.primitive,Certificates.LineControl.denominator,
    Certificates.LineControl.slopeNumerator,Variational.capSlack,StaticLow.lam,StaticLow.slack]
  try simp only [show z-p+(9/25-z+p)=(9/25:ℝ) by ring]
  field_simp [hcap]
  norm_num [n0,d0,n0Polynomial,d0Polynomial,RationalPolynomial3.eval,
    RationalPolynomial2.eval,RationalPolynomial.eval]
  <;> ring

theorem positive {p z : ℝ}
    (hp : p∈Icc (22493/40000:ℝ) (13/20))
    (hz : z∈Icc (391/500:ℝ) (7/8)) : 0<(-(headCleared (StaticLow.lam:ℝ) (StaticLow.slack:ℝ) p z (cubicControlDeficit (Certificates.LineControl.slope (StaticLow.lam:ℝ) (StaticLow.slack:ℝ)) (Certificates.LineControl.alpha (StaticLow.lam:ℝ) (StaticLow.slack:ℝ)) (Certificates.LineControl.crossing (StaticLow.lam:ℝ) (StaticLow.slack:ℝ)) z))) := by
  have hb : 0<n0 p z 0 ∧ 0<d0 p z 0 := by
    by_cases hm : p≤(48493/80000)
    · exact ⟨n0_pos ⟨hp.1,hm⟩ hz (by norm_num),d0_pos ⟨hp.1,hm⟩ hz (by norm_num)⟩
    · exact ⟨n1_pos ⟨(lt_of_not_ge hm).le,hp.2⟩ hz (by norm_num),
        d1_pos ⟨(lt_of_not_ge hm).le,hp.2⟩ hz (by norm_num)⟩
  rw [expression_identity p z 0 (by linarith only [hp.1,hz.2])] at hb
  exact (mul_pos_iff_of_pos_right hb.2).mp hb.1

