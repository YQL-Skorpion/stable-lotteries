  have he : nReduced.eval p z r=n p z r-(3866901144500597254898460897215601524729975736039/65660833466734375000000000000000000) := by
    norm_num [nReduced,RationalPolynomial3.eval_add,n,RationalPolynomial3.eval,RationalPolynomial2.eval,RationalPolynomial.eval] <;> ring
  change 0≤nReduced.eval p z r at hh
  rw [he] at hh
  have hm : (0:ℝ)<(3866901144500597254898460897215601524729975736039/65660833466734375000000000000000000) := by norm_num
  linarith only [hh,hm]

