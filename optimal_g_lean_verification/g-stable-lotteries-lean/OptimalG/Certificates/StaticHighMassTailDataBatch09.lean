theorem d_pos {p z r : ℝ}
    (hp : p∈Icc (1621/2000) (41/50))
    (hz : z∈Icc (397/400) 1)
    (hr : r∈Icc (3387/8000) (1947/4000))
    : 0<d p z r := by
