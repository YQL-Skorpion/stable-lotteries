theorem actual256_bounds {r : ℝ} (hr : r∈Ioo (cell256.lo:ℝ) cell256.hi) :
    cell256.position.Contains ReferenceDensityData.CoarseLowerShape.scale ((cell256.components.map (fun d=>ReferenceDensityData.CoarseLowerShape.force d r)).sum) ∧
    cell256.weight.Contains ReferenceDensityData.CoarseLowerShape.scale ((cell256.components.map (fun d=>ReferenceDensityData.CoarseLowerShape.weight d r)).sum) := by
  have hc := List.all_eq_true.mp checked cell256 (by simp only [cells,List.mem_cons,List.mem_singleton]; tauto)
  apply cell256.checked_sums hc
  · intro d hd
    have hi := cell256.checked_images hc hd hr
    simp only [cell256,List.mem_cons,List.not_mem_nil,or_false] at hd
    rcases hd with rfl | rfl
    · exact (ReferenceDensityData.CoarseLowerShape.Batch0021.actual250_0 hi).1
    · exact (ReferenceDensityData.CoarseLowerShape.Batch0011.actual166_1 hi).1
  · intro d hd
    have hi := cell256.checked_images hc hd hr
    simp only [cell256,List.mem_cons,List.not_mem_nil,or_false] at hd
    rcases hd with rfl | rfl
    · exact (ReferenceDensityData.CoarseLowerShape.Batch0021.actual250_0 hi).2
    · exact (ReferenceDensityData.CoarseLowerShape.Batch0011.actual166_1 hi).2
