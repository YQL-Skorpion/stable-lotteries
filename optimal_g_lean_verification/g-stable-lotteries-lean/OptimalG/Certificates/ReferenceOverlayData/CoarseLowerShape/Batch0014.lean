theorem actual448_bounds {r : ℝ} (hr : r∈Ioo (cell448.lo:ℝ) cell448.hi) :
    cell448.position.Contains ReferenceDensityData.CoarseLowerShape.scale ((cell448.components.map (fun d=>ReferenceDensityData.CoarseLowerShape.force d r)).sum) ∧
    cell448.weight.Contains ReferenceDensityData.CoarseLowerShape.scale ((cell448.components.map (fun d=>ReferenceDensityData.CoarseLowerShape.weight d r)).sum) := by
  have hc := List.all_eq_true.mp checked cell448 (by simp only [cells,List.mem_cons,List.mem_singleton]; tauto)
  apply cell448.checked_sums hc
  · intro d hd
    have hi := cell448.checked_images hc hd hr
    simp only [cell448,List.mem_cons,List.not_mem_nil,or_false] at hd
    rcases hd with rfl | rfl
    · exact (ReferenceDensityData.CoarseLowerShape.Batch0028.actual308_0 hi).1
    · exact (ReferenceDensityData.CoarseLowerShape.Batch0029.actual311_1 hi).1
  · intro d hd
    have hi := cell448.checked_images hc hd hr
    simp only [cell448,List.mem_cons,List.not_mem_nil,or_false] at hd
    rcases hd with rfl | rfl
    · exact (ReferenceDensityData.CoarseLowerShape.Batch0028.actual308_0 hi).2
