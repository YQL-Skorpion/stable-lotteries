theorem actual288_bounds {r : ℝ} (hr : r∈Ioo (cell288.lo:ℝ) cell288.hi) :
    cell288.position.Contains ReferenceDensityData.CoarseLowerShape.scale ((cell288.components.map (fun d=>ReferenceDensityData.CoarseLowerShape.force d r)).sum) ∧
    cell288.weight.Contains ReferenceDensityData.CoarseLowerShape.scale ((cell288.components.map (fun d=>ReferenceDensityData.CoarseLowerShape.weight d r)).sum) := by
  have hc := List.all_eq_true.mp checked cell288 (by simp only [cells,List.mem_cons,List.mem_singleton]; tauto)
  apply cell288.checked_sums hc
  · intro d hd
    have hi := cell288.checked_images hc hd hr
    simp only [cell288,List.mem_cons,List.not_mem_nil,or_false] at hd
    rcases hd with rfl | rfl
    · exact (ReferenceDensityData.CoarseLowerShape.Batch0022.actual257_0 hi).1
    · exact (ReferenceDensityData.CoarseLowerShape.Batch0014.actual191_1 hi).1
  · intro d hd
    have hi := cell288.checked_images hc hd hr
    simp only [cell288,List.mem_cons,List.not_mem_nil,or_false] at hd
    rcases hd with rfl | rfl
    · exact (ReferenceDensityData.CoarseLowerShape.Batch0022.actual257_0 hi).2
    · exact (ReferenceDensityData.CoarseLowerShape.Batch0014.actual191_1 hi).2
