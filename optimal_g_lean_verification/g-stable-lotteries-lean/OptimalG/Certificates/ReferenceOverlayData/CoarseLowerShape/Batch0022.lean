theorem actual704_bounds {r : ℝ} (hr : r∈Ioo (cell704.lo:ℝ) cell704.hi) :
    cell704.position.Contains ReferenceDensityData.CoarseLowerShape.scale ((cell704.components.map (fun d=>ReferenceDensityData.CoarseLowerShape.force d r)).sum) ∧
    cell704.weight.Contains ReferenceDensityData.CoarseLowerShape.scale ((cell704.components.map (fun d=>ReferenceDensityData.CoarseLowerShape.weight d r)).sum) := by
