theorem actual512_bounds {r : ℝ} (hr : r∈Ioo (cell512.lo:ℝ) cell512.hi) :
    cell512.position.Contains ReferenceDensityData.CoarseLowerShape.scale ((cell512.components.map (fun d=>ReferenceDensityData.CoarseLowerShape.force d r)).sum) ∧
    cell512.weight.Contains ReferenceDensityData.CoarseLowerShape.scale ((cell512.components.map (fun d=>ReferenceDensityData.CoarseLowerShape.weight d r)).sum) := by
  have hc := List.all_eq_true.mp checked cell512 (by simp only [cells,List.mem_cons,List.mem_singleton]; tauto)
  apply cell512.checked_sums hc
  · intro d hd
    have hi := cell512.checked_images hc hd hr
    simp only [cell512,List.mem_cons,List.not_mem_nil,or_false] at hd
    rcases hd with rfl | rfl
    · exact (ReferenceDensityData.CoarseLowerShape.Batch0031.actual328_0 hi).1
    · exact (ReferenceDensityData.CoarseLowerShape.Batch0035.actual363_1 hi).1
  · intro d hd
    have hi := cell512.checked_images hc hd hr
    simp only [cell512,List.mem_cons,List.not_mem_nil,or_false] at hd
    rcases hd with rfl | rfl
    · exact (ReferenceDensityData.CoarseLowerShape.Batch0031.actual328_0 hi).2
