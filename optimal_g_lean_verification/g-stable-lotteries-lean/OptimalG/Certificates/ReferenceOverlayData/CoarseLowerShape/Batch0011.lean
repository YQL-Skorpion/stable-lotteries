    cell352.position.Contains ReferenceDensityData.CoarseLowerShape.scale ((cell352.components.map (fun d=>ReferenceDensityData.CoarseLowerShape.force d r)).sum) ∧
    cell352.weight.Contains ReferenceDensityData.CoarseLowerShape.scale ((cell352.components.map (fun d=>ReferenceDensityData.CoarseLowerShape.weight d r)).sum) := by
