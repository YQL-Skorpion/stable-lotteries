  · intro d hd
    have hi := cell352.checked_images hc hd hr
    simp only [cell352,List.mem_cons,List.not_mem_nil,or_false] at hd
    rcases hd with rfl | rfl
    · exact (ReferenceDensityData.CoarseLowerShape.Batch0024.actual270_0 hi).2
