theorem actual384_bounds {r : ℝ} (hr : r∈Ioo (cell384.lo:ℝ) cell384.hi) :
    cell384.position.Contains ReferenceDensityData.CoarseLowerShape.scale ((cell384.components.map (fun d=>ReferenceDensityData.CoarseLowerShape.force d r)).sum) ∧
    cell384.weight.Contains ReferenceDensityData.CoarseLowerShape.scale ((cell384.components.map (fun d=>ReferenceDensityData.CoarseLowerShape.weight d r)).sum) := by
