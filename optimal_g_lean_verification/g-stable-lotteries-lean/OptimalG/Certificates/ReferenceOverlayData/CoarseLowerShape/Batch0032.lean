theorem actual1024_bounds {r : ℝ} (hr : r∈Ioo (cell1024.lo:ℝ) cell1024.hi) :
    cell1024.position.Contains ReferenceDensityData.CoarseLowerShape.scale ((cell1024.components.map (fun d=>ReferenceDensityData.CoarseLowerShape.force d r)).sum) ∧
    cell1024.weight.Contains ReferenceDensityData.CoarseLowerShape.scale ((cell1024.components.map (fun d=>ReferenceDensityData.CoarseLowerShape.weight d r)).sum) := by
  have hc := List.all_eq_true.mp checked cell1024 (by simp only [cells,List.mem_cons,List.mem_singleton]; tauto)
  apply cell1024.checked_sums hc
  · intro d hd
    have hi := cell1024.checked_images hc hd hr
    simp only [cell1024,List.mem_cons,List.not_mem_nil,or_false] at hd
    rcases hd with rfl
    · exact (ReferenceDensityData.CoarseLowerShape.Batch0059.actual549_0 hi).1
  · intro d hd
    have hi := cell1024.checked_images hc hd hr
    simp only [cell1024,List.mem_cons,List.not_mem_nil,or_false] at hd
    rcases hd with rfl
    · exact (ReferenceDensityData.CoarseLowerShape.Batch0059.actual549_0 hi).2
