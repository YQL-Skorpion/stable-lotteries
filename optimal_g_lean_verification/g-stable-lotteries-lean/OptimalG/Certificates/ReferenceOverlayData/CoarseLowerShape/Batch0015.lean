theorem actual480_bounds {r : ℝ} (hr : r∈Ioo (cell480.lo:ℝ) cell480.hi) :
    cell480.position.Contains ReferenceDensityData.CoarseLowerShape.scale ((cell480.components.map (fun d=>ReferenceDensityData.CoarseLowerShape.force d r)).sum) ∧
    cell480.weight.Contains ReferenceDensityData.CoarseLowerShape.scale ((cell480.components.map (fun d=>ReferenceDensityData.CoarseLowerShape.weight d r)).sum) := by
  have hc := List.all_eq_true.mp checked cell480 (by simp only [cells,List.mem_cons,List.mem_singleton]; tauto)
  apply cell480.checked_sums hc
  · intro d hd
    have hi := cell480.checked_images hc hd hr
    simp only [cell480,List.mem_cons,List.not_mem_nil,or_false] at hd
    rcases hd with rfl | rfl
    · exact (ReferenceDensityData.CoarseLowerShape.Batch0029.actual316_0 hi).1
    · exact (ReferenceDensityData.CoarseLowerShape.Batch0032.actual339_1 hi).1
  · intro d hd
    have hi := cell480.checked_images hc hd hr
    simp only [cell480,List.mem_cons,List.not_mem_nil,or_false] at hd
    rcases hd with rfl | rfl
    · exact (ReferenceDensityData.CoarseLowerShape.Batch0029.actual316_0 hi).2
    · exact (ReferenceDensityData.CoarseLowerShape.Batch0032.actual339_1 hi).2
