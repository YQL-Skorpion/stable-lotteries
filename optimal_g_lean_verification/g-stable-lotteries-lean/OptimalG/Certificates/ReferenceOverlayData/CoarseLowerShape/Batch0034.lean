theorem actual1088_bounds {r : ℝ} (hr : r∈Ioo (cell1088.lo:ℝ) cell1088.hi) :
    cell1088.position.Contains ReferenceDensityData.CoarseLowerShape.scale ((cell1088.components.map (fun d=>ReferenceDensityData.CoarseLowerShape.force d r)).sum) ∧
    cell1088.weight.Contains ReferenceDensityData.CoarseLowerShape.scale ((cell1088.components.map (fun d=>ReferenceDensityData.CoarseLowerShape.weight d r)).sum) := by
  have hc := List.all_eq_true.mp checked cell1088 (by simp only [cells,List.mem_cons,List.mem_singleton]; tauto)
  apply cell1088.checked_sums hc
  · intro d hd
    have hi := cell1088.checked_images hc hd hr
    simp only [cell1088,List.mem_cons,List.not_mem_nil,or_false] at hd
    rcases hd with rfl
    · exact (ReferenceDensityData.CoarseLowerShape.Batch0067.actual613_0 hi).1
  · intro d hd
    have hi := cell1088.checked_images hc hd hr
    simp only [cell1088,List.mem_cons,List.not_mem_nil,or_false] at hd
    rcases hd with rfl
    · exact (ReferenceDensityData.CoarseLowerShape.Batch0067.actual613_0 hi).2
