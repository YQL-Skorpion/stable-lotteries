theorem actual320_bounds {r : ℝ} (hr : r∈Ioo (cell320.lo:ℝ) cell320.hi) :
    cell320.position.Contains ReferenceDensityData.CoarseLowerShape.scale ((cell320.components.map (fun d=>ReferenceDensityData.CoarseLowerShape.force d r)).sum) ∧
    cell320.weight.Contains ReferenceDensityData.CoarseLowerShape.scale ((cell320.components.map (fun d=>ReferenceDensityData.CoarseLowerShape.weight d r)).sum) := by
