theorem actual416_bounds {r : ℝ} (hr : r∈Ioo (cell416.lo:ℝ) cell416.hi) :
    cell416.position.Contains ReferenceDensityData.CoarseLowerShape.scale ((cell416.components.map (fun d=>ReferenceDensityData.CoarseLowerShape.force d r)).sum) ∧
    cell416.weight.Contains ReferenceDensityData.CoarseLowerShape.scale ((cell416.components.map (fun d=>ReferenceDensityData.CoarseLowerShape.weight d r)).sum) := by
  have hc := List.all_eq_true.mp checked cell416 (by simp only [cells,List.mem_cons,List.mem_singleton]; tauto)
  apply cell416.checked_sums hc
  · intro d hd
    have hi := cell416.checked_images hc hd hr
    simp only [cell416,List.mem_cons,List.not_mem_nil,or_false] at hd
    rcases hd with rfl | rfl
    · exact (ReferenceDensityData.CoarseLowerShape.Batch0026.actual291_0 hi).1
    · exact (ReferenceDensityData.CoarseLowerShape.Batch0026.actual289_1 hi).1
  · intro d hd
    have hi := cell416.checked_images hc hd hr
    simp only [cell416,List.mem_cons,List.not_mem_nil,or_false] at hd
    rcases hd with rfl | rfl
    · exact (ReferenceDensityData.CoarseLowerShape.Batch0026.actual291_0 hi).2
