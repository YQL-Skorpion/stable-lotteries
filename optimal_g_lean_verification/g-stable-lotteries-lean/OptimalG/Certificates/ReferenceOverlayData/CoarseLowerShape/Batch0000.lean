theorem actual0_bounds {r : ℝ} (hr : r∈Ioo (cell0.lo:ℝ) cell0.hi) :
    cell0.position.Contains ReferenceDensityData.CoarseLowerShape.scale ((cell0.components.map (fun d=>ReferenceDensityData.CoarseLowerShape.force d r)).sum) ∧
    cell0.weight.Contains ReferenceDensityData.CoarseLowerShape.scale ((cell0.components.map (fun d=>ReferenceDensityData.CoarseLowerShape.weight d r)).sum) := by
  have hc := List.all_eq_true.mp checked cell0 (by simp only [cells,List.mem_cons,List.mem_singleton]; tauto)
  apply cell0.checked_sums hc
  · intro d hd
    have hi := cell0.checked_images hc hd hr
    simp only [cell0,List.mem_cons,List.not_mem_nil,or_false] at hd
    rcases hd with rfl | rfl
    · exact (ReferenceDensityData.CoarseLowerShape.Batch0009.actual154_0 hi).1
    · exact (ReferenceDensityData.CoarseLowerShape.Batch0000.actual0_1 hi).1
  · intro d hd
    have hi := cell0.checked_images hc hd hr
    simp only [cell0,List.mem_cons,List.not_mem_nil,or_false] at hd
    rcases hd with rfl | rfl
    · exact (ReferenceDensityData.CoarseLowerShape.Batch0009.actual154_0 hi).2
