theorem actual1152_bounds {r : ℝ} (hr : r∈Ioo (cell1152.lo:ℝ) cell1152.hi) :
    cell1152.position.Contains ReferenceDensityData.CoarseLowerShape.scale ((cell1152.components.map (fun d=>ReferenceDensityData.CoarseLowerShape.force d r)).sum) ∧
    cell1152.weight.Contains ReferenceDensityData.CoarseLowerShape.scale ((cell1152.components.map (fun d=>ReferenceDensityData.CoarseLowerShape.weight d r)).sum) := by
  have hc := List.all_eq_true.mp checked cell1152 (by simp only [cells,List.mem_cons,List.mem_singleton]; tauto)
  apply cell1152.checked_sums hc
  · intro d hd
    have hi := cell1152.checked_images hc hd hr
    simp only [cell1152,List.mem_cons,List.not_mem_nil,or_false] at hd
    rcases hd with rfl
    · exact (ReferenceDensityData.CoarseLowerShape.Batch0075.actual677_0 hi).1
  · intro d hd
    have hi := cell1152.checked_images hc hd hr
    simp only [cell1152,List.mem_cons,List.not_mem_nil,or_false] at hd
    rcases hd with rfl
    · exact (ReferenceDensityData.CoarseLowerShape.Batch0075.actual677_0 hi).2
