    (hp : p∈Icc (22493/40000:ℝ) (13/20))
    (hz : z∈Icc (391/500:ℝ) (7/8)) : 0<(-(highCore (StaticLow.lam:ℝ) (StaticLow.slack:ℝ) p z (cubicControlDeficit (Certificates.LineControl.slope (StaticLow.lam:ℝ) (StaticLow.slack:ℝ)) (Certificates.LineControl.alpha (StaticLow.lam:ℝ) (StaticLow.slack:ℝ)) (Certificates.LineControl.crossing (StaticLow.lam:ℝ) (StaticLow.slack:ℝ)) z) (kink (StaticLow.lam:ℝ) (StaticLow.slack:ℝ)) 0)) := by
  have hb : 0<n0 p z 0 ∧ 0<d0 p z 0 := by
    exact ⟨n0_pos hp hz (by norm_num),d0_pos hp hz (by norm_num)⟩
  rw [expression_identity p z 0 (by linarith only [hp.1,hz.2])] at hb
  exact (mul_pos_iff_of_pos_right hb.2).mp hb.1

