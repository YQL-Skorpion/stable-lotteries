    fin_cases i
    · simpa [n0Box,RatInterval.Contains] using hp
    · simpa [n0Box,RatInterval.Contains] using hz
    · simpa [n0Box,RatInterval.Contains] using hpad
  have hh := TensorBernstein3.scaledBoxCheck_sound n0Checked ![p, z, pad] hx
