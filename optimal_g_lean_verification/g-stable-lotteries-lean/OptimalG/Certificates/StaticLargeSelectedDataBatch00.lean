def numeratorPolynomial : RationalPolynomial3 := [[[(105900645844942709556023355728914949/182356754607288459180000000000000000)]], [[(-13/20)]]]
def numeratorReduced : RationalPolynomial3 := numeratorPolynomial.add [[[(-2185241662047398397398355728914949/364713509214576918360000000000000000)]]]
def numeratorBox : Fin 3→RatInterval := ![⟨(391/500), (7/8)⟩, ⟨0, 1⟩, ⟨0, 1⟩]
