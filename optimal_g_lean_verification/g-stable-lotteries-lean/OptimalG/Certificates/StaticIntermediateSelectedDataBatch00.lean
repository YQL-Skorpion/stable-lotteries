theorem n0_pos {p z pad : ℝ}
    (hp : p∈Icc (22493/40000) (13/20))
    (hz : z∈Icc (391/500) (7/8))
    (hpad : pad∈Icc 0 1)
    : 0<n0 p z pad := by
  have hx : ∀ i,(n0Box i).Contains (![p, z, pad] i) := by
    intro i
    fin_cases i
    · simpa [n0Box,RatInterval.Contains] using hp
    · simpa [n0Box,RatInterval.Contains] using hz
    · simpa [n0Box,RatInterval.Contains] using hpad
  have hh := TensorBernstein3.scaledBoxCheck_sound n0Checked ![p, z, pad] hx
  have he : n0Reduced.eval p z pad=n0 p z pad-() := by
    norm_num [n0Reduced,RationalPolynomial3.eval_add,n0,RationalPolynomial3.eval,RationalPolynomial2.eval,RationalPolynomial.eval] <;> ring
  change 0≤n0Reduced.eval p z pad at hh
  rw [he] at hh
  have hm : (0:ℝ)<() := by norm_num
  linarith only [hh,hm]

