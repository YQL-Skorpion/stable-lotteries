/-! An exact endpoint polynomial sign for C.4. -/
namespace OptimalG.Certificates.ExtendedCoefficientData.EtaDecreaseLo
open Set
set_option maxRecDepth 100000
set_option maxHeartbeats 0

def numeratorPolynomial : RationalPolynomial3 := [[[0, 0, (1529/20000), 0, (-1529/20000)], [(-1529/10000), (1529/2500), (-1529/5000)], [(-1529/5000)]], [[(1/4), -1, (10413/10000), (-3471/5000), (1/4)], [(6529/5000), (-6529/2500), 1], [1]], [[-1, (5/2), (-10971/5000), 1], [-3, 2]], [[(3/2), -1], [2]], [[-1]]]
def numeratorReduced : RationalPolynomial3 := numeratorPolynomial.add [[[(-2258448025111748359489/3200000000000000000000000)]]]
def numeratorBox : Fin 3→RatInterval := ![⟨(22493/40000), (56233/100000)⟩, ⟨(227179/10000000), (11677/500000)⟩, ⟨(9/25), (56233/100000)⟩]
def numeratorScale : ℚ := 80000000000000000000000000
def numeratorCertificate : DenseBernstein3 := [[[65202618291942505512775, 417837236286711016651100, 678173774800547556365650, 375701130416100747930350, 58760040472619482207930], [127985208769587090275550, 825584047049300475202200, 1341130838920812920311300, 741560004786810102320700, 115224137870306125945860], [62790894155160204762775, 407780025472651938551100, 663006886185359083945650, 365892089080771834390350, 56472401075202263737930]], [[260803975593725096701100, 1671327659012995664064400, 2712658036664831644959800, 1502770883572884565508460, 235028965363823100187101], [511927807798108145752200, 3302293505815601965168800, 5364449103475846725775600, 2966172690511935901008920, 460874155126582219200202], [251157047076294813051100, 1631098706290253357104400, 2651990356042485664815800, 1463534666426698391500460, 225878404634670883013101]], [[391196216455590242936650, 2506959556888425811414600, 4068931457252679472048740, 2254105865356719885904434, 352526652472588142129637], [767872169630333590613300, 4953376230296494583761200, 8046562269035497170681480, 4449158037091399761140868, 691277636593487903199274], [376725775725384919676650, 2446615963610635060346600, 3977929747086667130632740, 2195251461937246163236434, 338800806671541333069637]], [[260790979297764579179100, 1671285081884664119372400, 2712583903712984332928680, 1502703601659140442536888, 235006570744172250587691], [511901750944669840510200, 3302208131343296067976800, 5364300583326566118109360, 2966038021794135030489776, 460829359288428341419382], [251143986842515593331100, 1631055910241073276604400, 2651915970787243777180680, 1463467280917435915952888, 225856003739866422831691]], [[65196120143956927380775, 417815947722522955171100, 678136708324588949174090, 375667489459204374010564, 58748843162787726387225], [127972180342857305273550, 825541359813102973782200, 1341056578846102752292180, 741492670427861067637128, 115201739951216531374450], [62784364038265281892775, 407758627448039634611100, 662969693557703227118090, 365858396326116309626564, 56461200627793708987225]]]
noncomputable def numerator (lam S p : ℝ) : ℝ := numeratorPolynomial.eval lam S p

theorem numeratorChecked : numeratorCertificate.scaledBoxCheck numeratorScale numeratorReduced numeratorBox=true := by
  decide +kernel

theorem numerator_pos {lam S p : ℝ}
    (hlam : lam∈Icc (22493/40000) (56233/100000))
    (hS : S∈Icc (227179/10000000) (11677/500000))
    (hp : p∈Icc (9/25) (56233/100000))
    : 0<numerator lam S p := by
  have hx : ∀ i,(numeratorBox i).Contains (![lam, S, p] i) := by
    intro i
    fin_cases i
    · simpa [numeratorBox,RatInterval.Contains] using hlam
    · simpa [numeratorBox,RatInterval.Contains] using hS
    · simpa [numeratorBox,RatInterval.Contains] using hp
  have hh := DenseBernstein3.scaledBoxCheck_sound numeratorChecked ![lam, S, p] hx
  have he : numeratorReduced.eval lam S p=numerator lam S p-(2258448025111748359489/3200000000000000000000000) := by
    norm_num [numeratorReduced,RationalPolynomial3.eval_add,numerator,RationalPolynomial3.eval,RationalPolynomial2.eval,RationalPolynomial.eval] <;> ring
  change 0≤numeratorReduced.eval lam S p at hh
  rw [he] at hh
  have hm : (0:ℝ)<(2258448025111748359489/3200000000000000000000000) := by norm_num
  linarith only [hh,hm]

 theorem expression_identity (lam S p : ℝ) :
    numerator lam S p=ExtendedScalarExpressions.etaDecrease lam S p (1529/5000) := by
  norm_num [numerator,numeratorPolynomial,RationalPolynomial3.eval,RationalPolynomial2.eval,RationalPolynomial.eval,ExtendedScalarExpressions.etaDecrease,
    ExtendedScalarExpressions.denominator,ExtendedScalarExpressions.etaNumerator,
    ExtendedScalarExpressions.betaNumerator,ExtendedScalarExpressions.denominatorDerivative,
    ExtendedScalarExpressions.etaNumeratorDerivative,SmallMassExpressions.initial,
    headInitial,Variational.cap,Variational.capScore,Variational.quadratic]
  <;> ring

end OptimalG.Certificates.ExtendedCoefficientData.EtaDecreaseLo
