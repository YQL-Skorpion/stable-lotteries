theorem x50_integer_checked : x50_integer.flatCoeffCheck x50 literalRows literalTerms literalRhs (baseCount+50) x50_expansion = true := by
  simp only [IntegerDualCertificate.flatCoeffCheck,IntegerDualCertificate.checkWithCoefficients,Bool.and_eq_true_iff,decide_eq_true_eq]
  exact ⟨x50_expansion_checked, ⟨⟨⟨⟨⟨⟨⟨⟨⟨x50_indices_checked, x50_sign_checked⟩, x50_objective_checked⟩, x50_rows_checked⟩, x50_coefficients_checked⟩, x50_residual_checked⟩, x50_rhs_checked⟩, x50_box_checked⟩, x50_bound_checked⟩, x50_sum_checked⟩⟩
theorem x50_checked : x50.checkCached rows cachedTerms cachedRhs (baseCount+50) = true := by
  have hc := IntegerDualCertificate.checkCached_of_flatCoeffCheck x50_integer_checked
  simpa only [literalRows_eq,literalTerms_eq,literalRhs_eq] using hc
