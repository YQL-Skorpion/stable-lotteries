  simp only [IntegerDualCertificate.flatCoeffCheck,IntegerDualCertificate.checkWithCoefficients,Bool.and_eq_true_iff,decide_eq_true_eq]
  exact ⟨x38_expansion_checked, ⟨⟨⟨⟨⟨⟨⟨⟨⟨x38_indices_checked, x38_sign_checked⟩, x38_objective_checked⟩, x38_rows_checked⟩, x38_coefficients_checked⟩, x38_residual_checked⟩, x38_rhs_checked⟩, x38_box_checked⟩, x38_bound_checked⟩, x38_sum_checked⟩⟩
theorem x38_checked : x38.checkCached rows cachedTerms cachedRhs (baseCount+38) = true := by
  have hc := IntegerDualCertificate.checkCached_of_flatCoeffCheck x38_integer_checked
  simpa only [literalRows_eq,literalTerms_eq,literalRhs_eq] using hc
