  exact ⟨y16_expansion_checked, ⟨⟨⟨⟨⟨⟨⟨⟨⟨y16_indices_checked, y16_sign_checked⟩, y16_objective_checked⟩, y16_rows_checked⟩, y16_coefficients_checked⟩, y16_residual_checked⟩, y16_rhs_checked⟩, y16_box_checked⟩, y16_bound_checked⟩, y16_sum_checked⟩⟩
theorem y16_checked : y16.checkCached rows cachedTerms cachedRhs (baseCount+16) = true := by
  have hc := IntegerDualCertificate.checkCached_of_flatCoeffCheck y16_integer_checked
  simpa only [literalRows_eq,literalTerms_eq,literalRhs_eq] using hc
#print axioms y16_checked
