  exact ⟨y30_expansion_checked, ⟨⟨⟨⟨⟨⟨⟨⟨⟨y30_indices_checked, y30_sign_checked⟩, y30_objective_checked⟩, y30_rows_checked⟩, y30_coefficients_checked⟩, y30_residual_checked⟩, y30_rhs_checked⟩, y30_box_checked⟩, y30_bound_checked⟩, y30_sum_checked⟩⟩
theorem y30_checked : y30.checkCached rows cachedTerms cachedRhs (baseCount+30) = true := by
  have hc := IntegerDualCertificate.checkCached_of_flatCoeffCheck y30_integer_checked
  simpa only [literalRows_eq,literalTerms_eq,literalRhs_eq] using hc
