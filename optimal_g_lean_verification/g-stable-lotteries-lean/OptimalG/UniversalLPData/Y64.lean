  exact ⟨y64_expansion_checked, ⟨⟨⟨⟨⟨⟨⟨⟨⟨y64_indices_checked, y64_sign_checked⟩, y64_objective_checked⟩, y64_rows_checked⟩, y64_coefficients_checked⟩, y64_residual_checked⟩, y64_rhs_checked⟩, y64_box_checked⟩, y64_bound_checked⟩, y64_sum_checked⟩⟩
theorem y64_checked : y64.checkCached rows cachedTerms cachedRhs (baseCount+64) = true := by
