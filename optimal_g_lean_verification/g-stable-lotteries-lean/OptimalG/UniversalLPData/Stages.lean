    (envelope4.bound : ℝ) ≤ (1 : ℝ) * activationPrimitive phi (100 / 200) := by
  have hh := final_objective_bound h envelope4 envelope4_checked
  change (envelope4.bound : ℝ) ≤ termsValue (gridValues phi) [(100, 1)] at hh
  simp only [termsValue, List.map_cons, List.sum_cons, List.map_nil, List.sum_nil] at hh
  rw [termValue_J phi 100 1 (by norm_num)] at hh
  simpa only [Nat.cast_ofNat, Rat.cast_one, Rat.cast_neg, add_zero] using hh

theorem envelope5_bound {phi : ℝ → ℝ} (h : NormalizedNecessaryConditions (L : ℝ) phi) :
    (envelope5.bound : ℝ) ≤ (-1 : ℝ) * activationPrimitive phi (100 / 200) := by
  have hh := final_objective_bound h envelope5 envelope5_checked
  change (envelope5.bound : ℝ) ≤ termsValue (gridValues phi) [(100, -1)] at hh
  simp only [termsValue, List.map_cons, List.sum_cons, List.map_nil, List.sum_nil] at hh
  rw [termValue_J phi 100 (-1) (by norm_num)] at hh
  simpa only [Nat.cast_ofNat, Rat.cast_one, Rat.cast_neg, add_zero] using hh

