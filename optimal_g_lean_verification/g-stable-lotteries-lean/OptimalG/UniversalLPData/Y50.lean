    simpa only [heq] using hc
  · have hi : 400+j.val%16=j.val := by omega
    have hc := y50_coeff25_checked ⟨j.val%16,by omega⟩
    have heq : (⟨400+j.val%16, by omega⟩ : Variables) = j := Fin.ext hi
    simpa only [heq] using hc
theorem y50_integer_checked : y50_integer.flatCoeffCheck y50 literalRows literalTerms literalRhs (baseCount+50) y50_expansion = true := by
  simp only [IntegerDualCertificate.flatCoeffCheck,IntegerDualCertificate.checkWithCoefficients,Bool.and_eq_true_iff,decide_eq_true_eq]
  exact ⟨y50_expansion_checked, ⟨⟨⟨⟨⟨⟨⟨⟨⟨y50_indices_checked, y50_sign_checked⟩, y50_objective_checked⟩, y50_rows_checked⟩, y50_coefficients_checked⟩, y50_residual_checked⟩, y50_rhs_checked⟩, y50_box_checked⟩, y50_bound_checked⟩, y50_sum_checked⟩⟩
theorem y50_checked : y50.checkCached rows cachedTerms cachedRhs (baseCount+50) = true := by
  have hc := IntegerDualCertificate.checkCached_of_flatCoeffCheck y50_integer_checked
  simpa only [literalRows_eq,literalTerms_eq,literalRhs_eq] using hc
