    have heq : (⟨400+j.val%16, by omega⟩ : Variables) = j := Fin.ext hi
    simpa only [heq] using hc
theorem x42_integer_checked : x42_integer.flatCoeffCheck x42 literalRows literalTerms literalRhs (baseCount+42) x42_expansion = true := by
  simp only [IntegerDualCertificate.flatCoeffCheck,IntegerDualCertificate.checkWithCoefficients,Bool.and_eq_true_iff,decide_eq_true_eq]
  exact ⟨x42_expansion_checked, ⟨⟨⟨⟨⟨⟨⟨⟨⟨x42_indices_checked, x42_sign_checked⟩, x42_objective_checked⟩, x42_rows_checked⟩, x42_coefficients_checked⟩, x42_residual_checked⟩, x42_rhs_checked⟩, x42_box_checked⟩, x42_bound_checked⟩, x42_sum_checked⟩⟩
theorem x42_checked : x42.checkCached rows cachedTerms cachedRhs (baseCount+42) = true := by
  have hc := IntegerDualCertificate.checkCached_of_flatCoeffCheck x42_integer_checked
  simpa only [literalRows_eq,literalTerms_eq,literalRhs_eq] using hc
