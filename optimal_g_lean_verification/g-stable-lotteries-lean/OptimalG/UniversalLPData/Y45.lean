    have heq : (⟨384+j.val%16, by omega⟩ : Variables) = j := Fin.ext hi
    simpa only [heq] using hc
  · have hi : 400+j.val%16=j.val := by omega
    have hc := y45_coeff25_checked ⟨j.val%16,by omega⟩
    have heq : (⟨400+j.val%16, by omega⟩ : Variables) = j := Fin.ext hi
    simpa only [heq] using hc
theorem y45_integer_checked : y45_integer.flatCoeffCheck y45 literalRows literalTerms literalRhs (baseCount+45) y45_expansion = true := by
  simp only [IntegerDualCertificate.flatCoeffCheck,IntegerDualCertificate.checkWithCoefficients,Bool.and_eq_true_iff,decide_eq_true_eq]
  exact ⟨y45_expansion_checked, ⟨⟨⟨⟨⟨⟨⟨⟨⟨y45_indices_checked, y45_sign_checked⟩, y45_objective_checked⟩, y45_rows_checked⟩, y45_coefficients_checked⟩, y45_residual_checked⟩, y45_rhs_checked⟩, y45_box_checked⟩, y45_bound_checked⟩, y45_sum_checked⟩⟩
theorem y45_checked : y45.checkCached rows cachedTerms cachedRhs (baseCount+45) = true := by
  have hc := IntegerDualCertificate.checkCached_of_flatCoeffCheck y45_integer_checked
