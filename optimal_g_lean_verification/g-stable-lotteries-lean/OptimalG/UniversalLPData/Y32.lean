  exact ⟨y32_expansion_checked, ⟨⟨⟨⟨⟨⟨⟨⟨⟨y32_indices_checked, y32_sign_checked⟩, y32_objective_checked⟩, y32_rows_checked⟩, y32_coefficients_checked⟩, y32_residual_checked⟩, y32_rhs_checked⟩, y32_box_checked⟩, y32_bound_checked⟩, y32_sum_checked⟩⟩
theorem y32_checked : y32.checkCached rows cachedTerms cachedRhs (baseCount+32) = true := by
  have hc := IntegerDualCertificate.checkCached_of_flatCoeffCheck y32_integer_checked
  simpa only [literalRows_eq,literalTerms_eq,literalRhs_eq] using hc
